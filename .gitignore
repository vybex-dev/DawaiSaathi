# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.keystore
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# --- Private evidence: strip photos stay on the laptop ---
private-strips/
**/private-strips/
data/strips/*.jpg
data/strips/*.jpeg
data/strips/*.png
data/strips/*.heic

# --- Node / package managers ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Expo ---
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# --- Metro ---
.metro-health-check*

# --- Android build outputs (prebuild generates android/) ---
android/
.gradle/
local.properties
*.apk
*.aab
*.hprof

# --- iOS (not targeted, but ignore if prebuild creates it) ---
ios/
Pods/
*.xcworkspace
*.xcuserstate

# --- Supabase local dev ---
supabase/.branches
supabase/.temp
supabase/.env
supabase/functions/.env
supabase/functions/**/.env

# --- Generated build output from tools/ ---
build/
coverage/

# --- Editors and OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.log
