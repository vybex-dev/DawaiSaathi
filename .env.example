# Copy this file to .env and fill in the two values from your Supabase project
# (Project Settings > API). Only the publishable (public) key goes here.
#
# Gemini and Groq keys are never here; they live in Supabase secrets
# (set with: npx supabase secrets set NAME=value).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
